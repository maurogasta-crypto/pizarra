<?xml version="1.0" encoding="utf-8"?>
<!-- La sesión (el refreshToken) no viaja en una copia de seguridad ni al
     pasar a otro teléfono: en el nuevo se entra de nuevo, una vez. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
