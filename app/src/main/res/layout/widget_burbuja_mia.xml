<?xml version="1.0" encoding="utf-8"?>
<!-- pizarra-61: una burbuja de la conversación en el widget (mia). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/burbuja"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:background="@drawable/burbuja_mia"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">
        <TextView
            android:id="@+id/burbuja_texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1B1D21"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/burbuja_hora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#5A4A20"
            android:textSize="10sp"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
