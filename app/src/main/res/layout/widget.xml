<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pizarra"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8A8F98"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/dictar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="🎙"
            android:textSize="18sp"
            android:contentDescription="Dictar para Tiempos" />
        <TextView
            android:id="@+id/actualizar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="⟳"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:contentDescription="Actualizar" />
        <TextView
            android:id="@+id/editar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="✎"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:contentDescription="Elegir tareas" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp">
        <ListView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#22FFFFFF"
            android:dividerHeight="1dp" />
        <TextView
            android:id="@+id/vacia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#8A8F98"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
