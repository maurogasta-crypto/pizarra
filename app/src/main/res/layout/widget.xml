<?xml version="1.0" encoding="utf-8"?>
<!-- pizarra-31 (14-oct-2026, Mauro: «que aparezcan al menos 8 ítems… los
     botones de las luces, el + y el lápiz en un costado para que la lista
     pueda ser más larga; para las luces, sólo la inicial»). La lista ocupa
     todo el alto; los botones van en una columna angosta a la derecha. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="@drawable/fondo">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/estado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8A8F98"
            android:textSize="10sp"
            android:maxLines="1" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp">
            <ListView
                android:id="@+id/lista"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="#22FFFFFF"
                android:dividerHeight="1dp" />
            <TextView
                android:id="@+id/vacia"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#8A8F98"
                android:textSize="13sp" />
        </FrameLayout>
    </LinearLayout>

    <!-- La columna de botones: E y D (luces de remate), ＋, ⟳ y ✎. -->
    <LinearLayout
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <TextView
            android:id="@+id/luz_entrada"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:background="#2A2E35"
            android:text="E"
            android:textColor="#C8CCD0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:contentDescription="Prender o apagar la luz de la entrada" />
        <TextView
            android:id="@+id/luz_deposito"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:background="#2A2E35"
            android:text="D"
            android:textColor="#C8CCD0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:contentDescription="Prender o apagar la luz del depósito" />
        <TextView
            android:id="@+id/agregar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="＋"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:contentDescription="Agregar a la pizarra" />
        <TextView
            android:id="@+id/gasto"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="$"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:contentDescription="Cargar un gasto" />
        <TextView
            android:id="@+id/editar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✎"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:contentDescription="Elegir tareas" />
        <TextView
            android:id="@+id/actualizar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="⟳"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:contentDescription="Actualizar" />
    </LinearLayout>
</LinearLayout>
