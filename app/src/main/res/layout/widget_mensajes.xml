<?xml version="1.0" encoding="utf-8"?>
<!-- pizarra-40: el widget de mensajes y novedades (Mensajes.kt). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/titulo_mensajes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬 Mensajes y novedades"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/estado_mensajes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8A8F98"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>

        <!-- pizarra-63: llamar a la conversación elegida. -->
        <TextView
            android:id="@+id/llamar_mensaje"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="📞"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:visibility="gone"
            android:contentDescription="Llamar" />
        <!-- pizarra-62: el handy. -->
        <TextView
            android:id="@+id/grabar_mensaje"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="🎙"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:contentDescription="Grabar un audio" />
        <TextView
            android:id="@+id/escribir_mensaje"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="✎"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:contentDescription="Escribir" />
        <TextView
            android:id="@+id/actualizar_mensajes"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="⟳"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:contentDescription="Actualizar" />
    </LinearLayout>

    <!-- pizarra-61: las pestañas. «Todo» y hasta tres conversaciones (Mensajes.kt). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/pestana_0" style="@style/Pestana" android:text="Todo" />
        <TextView android:id="@+id/pestana_1" style="@style/Pestana" android:visibility="gone" />
        <TextView android:id="@+id/pestana_2" style="@style/Pestana" android:visibility="gone" />
        <TextView android:id="@+id/pestana_3" style="@style/Pestana" android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">
        <ListView
            android:id="@+id/lista_mensajes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp" />
        <ListView
            android:id="@+id/lista_charla"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:stackFromBottom="true"
            android:transcriptMode="alwaysScroll"
            android:visibility="gone" />
        <TextView
            android:id="@+id/vacia_mensajes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#8A8F98"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
