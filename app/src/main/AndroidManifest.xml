<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Sin éste, programar el trabajo de cada hora «con red» CIERRA la app al
         abrir (pizarra-3, en el teléfono de Mauro). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- pizarra-2: las alarmas y recordatorios de Tiempos (Alarmas.kt) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- pizarra-6: la sirena es un servicio en primer plano que reproduce el sonido de alarma -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />


    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/sin_copias"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- pizarra-12: lo que abre el ícono es Tiempos ADENTRO de la app. -->
        <activity
            android:name=".TiemposActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Los ajustes de la app y la puerta de «Compartir». -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Ajustes de Tiempos"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <!-- pizarra-7: «Compartir → Tiempos» desde Instagram, Facebook, TikTok,
                 WhatsApp o el navegador: un link, un texto o una captura. -->
            <intent-filter android:label="Agendar en Tiempos">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="Agendar en Tiempos">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".PizarraWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <receiver
            android:name=".AlarmaReceptor"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".AlarmaPantalla"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <service
            android:name=".SirenaServicio"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".SincroTrabajo"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- pizarra-9: lee las notificaciones de Airbnb y las sube a la bodega
             (Bodega.kt). Android lo conecta recién cuando la persona le da el
             acceso; la app la lleva a ese renglón. -->
        <service
            android:name=".LectorAirbnb"
            android:exported="true"
            android:label="Pizarra · mensajes de Airbnb"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".FilasServicio"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>
</manifest>
