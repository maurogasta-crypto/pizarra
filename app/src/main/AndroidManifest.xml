<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- pizarra-13: ubicación APROXIMADA, sólo para que Tiempos sepa en qué país
         estás (de qué casa sale la alarma de salir). Se pide al usarla. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Sin éste, programar el trabajo de cada hora «con red» CIERRA la app al
         abrir (pizarra-3, en el teléfono de Mauro). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- pizarra-2: las alarmas y recordatorios de Tiempos (Alarmas.kt) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- pizarra-6: la sirena es un servicio en primer plano que reproduce el sonido de alarma -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />


    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/sin_copias"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- pizarra-12: lo que abre el ícono es Tiempos ADENTRO de la app. -->
        <activity
            android:name=".TiemposActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Los ajustes de la app y la puerta de «Compartir». -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Ajustes de Tiempos"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <!-- pizarra-7: «Compartir → Tiempos» desde Instagram, Facebook, TikTok,
                 WhatsApp o el navegador: un link, un texto o una captura. -->
            <intent-filter android:label="Agendar en Tiempos">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="Agendar en Tiempos">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".PizarraWidget"
            android:exported="false"
            android:label="Pizarra">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- pizarra-20: el segundo widget, la agenda de la semana (AgendaWidget.kt). -->
        <receiver
            android:name=".AgendaWidget"
            android:exported="false"
            android:label="Mi agenda">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agenda_info" />
        </receiver>

        <!-- pizarra-40: el tercer widget, mensajes y novedades (Mensajes.kt). -->
        <receiver
            android:name=".MensajesWidget"
            android:exported="false"
            android:label="Mensajes y novedades">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mensajes_info" />
        </receiver>

        <receiver
            android:name=".CharlaReceptor"
            android:exported="false" />

        <!-- pizarra-26: las luces tibias de 8 a 23 (Tibio.kt). -->
        <receiver
            android:name=".TibioReceptor"
            android:exported="false" />

        <receiver
            android:name=".AlarmaReceptor"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- pizarra-23: el toque en un renglón de la pizarra: el ☐ tacha, el
             texto abre la tarea. Invisible, y no queda en Recientes. -->
        <activity
            android:name=".ToqueActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- pizarra-37: el toque en el aviso de un pedido de Facebook: copia la
             respuesta y abre la publicación. Invisible, como la de arriba. -->
        <activity
            android:name=".ResponderActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- pizarra-40: la charla (escribir y leer los mensajes), y los toques del widget de mensajes. -->
        <activity
            android:name=".CharlaActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar" />

        <!-- pizarra-30: el ＋ del widget. Una ventanita encima del inicio. -->
        <activity
            android:name=".AgregarActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="stateVisible|adjustResize"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar" />

        <activity
            android:name=".AlarmaPantalla"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <service
            android:name=".SirenaServicio"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".SincroTrabajo"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- pizarra-9: lee las notificaciones de Airbnb y las sube a la bodega
             (Bodega.kt). Desde pizarra-34 también los pedidos de alquiler en
             Canasvieiras de los grupos de Facebook. El nombre de la clase no
             cambia: el permiso que dio Android va atado a él. Android lo conecta recién cuando la persona le da el
             acceso; la app la lleva a ese renglón. -->
        <!-- pizarra-44: el lector de Facebook por accesibilidad (Pantalla.kt).
             Sólo dentro de las apps de Facebook (res/xml/lector_pantalla.xml) y
             sólo lee. Se enciende en Ajustes → Accesibilidad → Pizarra. -->
        <service
            android:name=".LectorPantalla"
            android:exported="true"
            android:label="Pizarra · lector de Facebook"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lector_pantalla" />
        </service>

        <service
            android:name=".LectorAirbnb"
            android:exported="true"
            android:label="Pizarra · Airbnb y pedidos de Facebook"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".FilasServicio"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <service
            android:name=".MensajesServicio"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <service
            android:name=".AgendaServicio"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>
</manifest>
